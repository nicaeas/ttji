.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 20rpx;
}

/* 概览三栏 */
.stat-row {
  display: flex;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c2c2c;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a0a0a0;
}

/* 月份分布 */
.month-grid {
  display: flex;
  flex-wrap: wrap;
}
.month-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.month-key {
  font-size: 24rpx;
  color: #6b6b6b;
}
.month-count {
  font-size: 24rpx;
  color: #b87e14;
  font-weight: 600;
}

/* 标签 */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #b87e14;
  background: #fff3dc;
  border-radius: 999rpx;
}

/* 数据操作 */
.btn-row {
  margin-bottom: 20rpx;
}
.btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
}
.btn:active {
  opacity: 0.85;
}
.btn-ghost {
  color: #b87e14;
  background: #fff3dc;
}
.btn-primary {
  color: #ffffff;
  background: #e8a33d;
}

.tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a8a8a8;
}