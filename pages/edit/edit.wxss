.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 260rpx;
  box-sizing: border-box;
}

.meta {
  margin: 4rpx 4rpx 20rpx;
  font-size: 24rpx;
  color: #a8a8a8;
}

/* 快速模板（自适应换行，排数随内容增加） */
.tpl-bar {
  margin-bottom: 20rpx;
}
.tpl-label {
  display: block;
  font-size: 24rpx;
  color: #a8a8a8;
  margin: 0 4rpx 14rpx;
}
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}
.tpl-chip {
  padding: 12rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 26rpx;
  color: #6b6b6b;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.tpl-chip:active {
  background: #fff3dc;
}
.tpl-manage {
  color: #b87e14;
  background: #fff3dc;
}

/* 可点选标签池（自适应换行，排数随内容增加） */
.sug-bar {
  margin: 4rpx 0;
}
.sug-label {
  display: block;
  font-size: 22rpx;
  color: #a8a8a8;
  margin: 0 4rpx 12rpx;
}
.sug-chip {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #6b6b6b;
  background: #ffffff;
  border: 1rpx solid #e8e6e0;
  border-radius: 999rpx;
}
.sug-chip:active {
  color: #b87e14;
  border-color: #e8a33d;
}

.title-input {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2c2c;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.content-input {
  width: 100%;
  height: 44vh;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ph {
  color: #b8b8b8;
  font-weight: normal;
}

/* 标签编辑 */
.tag-editor {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
}
.tag-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 24rpx;
  color: #b87e14;
  background: #fff3dc;
  border-radius: 999rpx;
}
.tag-del {
  margin-left: 10rpx;
  color: #d9a441;
  font-size: 22rpx;
}
.tag-input {
  flex: 1;
  min-width: 200rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 图片附件 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 14rpx 14rpx 0;
}
.img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: #f2f1ee;
}
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
}

/* 语音附件 */
.audio-list {
  margin-top: 6rpx;
}
.audio-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.audio-play {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  background: #e8a33d;
  border-radius: 50%;
}
.audio-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #555;
}
.audio-del {
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 8rpx;
}

/* 附件操作按钮 */
.attach-row {
  display: flex;
  margin-top: 10rpx;
}
.attach-btn {
  padding: 16rpx 30rpx;
  margin-right: 18rpx;
  font-size: 26rpx;
  color: #6b6b6b;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.attach-btn:active {
  background: #f0efec;
}
.attach-btn.recording {
  color: #ffffff;
  background: #e5484d;
}

/* 底部操作栏（适配 iPhone 底部安全区） */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 245, 242, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
.btn:active {
  opacity: 0.85;
}
.btn-danger {
  margin-right: 20rpx;
  color: #e5484d;
  background: #ffffff;
}
.btn-ghost {
  margin-right: 20rpx;
  color: #b87e14;
  background: #fff3dc;
}
.btn-primary {
  color: #ffffff;
  background: #e8a33d;
}
