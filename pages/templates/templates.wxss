.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.tip {
  margin: 4rpx 8rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #a0a0a0;
}

.tpl-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tpl-head {
  display: flex;
  align-items: center;
}
.tpl-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}
.tpl-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tpl-badge {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #a0a0a0;
  background: #f2f1ee;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.badge-modified {
  color: #b87e14;
  background: #fff3dc;
}
.tpl-acts {
  display: flex;
}
.act {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
}
.act:active {
  opacity: 0.8;
}
.act-edit {
  color: #b87e14;
  background: #fff3dc;
}
.act-del {
  color: #e5484d;
  background: #fdecec;
}
.tpl-preview {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a8a8a8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #e8a33d;
  border-radius: 44rpx;
}
.add-btn:active {
  opacity: 0.85;
}
