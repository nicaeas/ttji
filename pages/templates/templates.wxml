<view class="page">
  <view class="tip">内置模板可修改（改后可恢复默认），自定义模板可新建、编辑、删除，新建笔记时直接选用。</view>

  <!-- 模板列表 -->
  <view class="tpl-card" wx:for="{{list}}" wx:key="id">
    <view class="tpl-head">
      <text class="tpl-icon">{{item.icon}}</text>
      <text class="tpl-name">{{item.name}}</text>
      <text wx:if="{{item.builtin && item.overridden}}" class="tpl-badge badge-modified">已修改</text>
      <text wx:elif="{{item.builtin}}" class="tpl-badge">内置</text>
      <view class="tpl-acts">
        <text class="act act-edit" data-id="{{item.id}}" bindtap="onOpenEdit">编辑</text>
        <text wx:if="{{!item.builtin}}" class="act act-del" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <text class="tpl-preview">{{item.preview}}</text>
  </view>

  <view class="add-btn" bindtap="onOpenEdit">＋ 新建自定义模板</view>
</view>
